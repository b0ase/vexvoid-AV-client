{
  "name": "v3xv0id-av-client",
  "version": "3.0.0",
  "description": "V3XV0ID AV Client - live visual performance tool: layered VX engine (clip deck, mercury, point fields, decals, sound) under operator image/video layers",
  "main": "main.js",
  "homepage": "./",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron ./main.js",
    "build": "electron-builder",
    "build-mac": "electron-builder --mac --publish=never",
    "build-win": "electron-builder --win --publish=never",
    "build-linux": "electron-builder --linux --publish=never",
    "dist": "electron-builder --mac --win --linux --publish=never",
    "sync-docs": "cp vx/vx-engine.js vx/vx-keys.js docs/"
  },
  "keywords": [
    "animation",
    "image",
    "electron",
    "effects",
    "vj",
    "performance",
    "visual",
    "audio",
    "sequencer",
    "v3xv0id",
    "cloud"
  ],
  "author": "FRESH",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "@supabase/supabase-js": "^2.50.0"
  },
  "build": {
    "appId": "com.b0ase.v3xv0id-av-client",
    "productName": "V3XV0ID AV Client",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "controls.html",
      "control-window.html",
      "supabase-config.js",
      "audio-manager.js",
      "performance-sequencer.js",
      "package.json",
      "vexvoid-icon.png",
      "vx/**/*"
    ],
    "icon": "vexvoid-icon.png",
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "vexvoid-icon.png",
      "identity": "Richard Boase (ZQ4NX9NJ89)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "V3XV0ID-AV-Client-${version}-mac-universal.${ext}"
    },
    "win": {
      "icon": "vexvoid-icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "V3XV0ID-AV-Client-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "icon": "vexvoid-icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "V3XV0ID-AV-Client-${version}-linux-${arch}.${ext}",
      "category": "AudioVideo",
      "maintainer": "b0ase"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "V3XV0ID-AV-Client-${version}-win-${arch}-setup.${ext}"
    },
    "dmg": {
      "artifactName": "V3XV0ID-AV-Client-${version}-mac-universal.${ext}"
    },
    "portable": {
      "artifactName": "V3XV0ID-AV-Client-${version}-win-${arch}-portable.${ext}"
    }
  }
}
