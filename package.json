{
  "name": "v3xv0id-av-client",
  "version": "3.1.0",
  "description": "V3XV0ID AV Client - live visual performance tool: layered VX engine (clip deck, mercury, point fields, decals, sound) under operator image/video layers",
  "main": "main.js",
  "homepage": "./",
  "scripts": {
    "test": "pnpm check",
    "check": "node scripts/check-scripts.js controls.html index.html relay/static/replay.html && node --check relay/server.js && node -e \"for (const f of ['main.js','relay-link.js','api-server.js',...require('fs').readdirSync('vx').filter(f=>f.endsWith('.js')).map(f=>'vx/'+f)]) require('child_process').execFileSync(process.execPath,['--check',f],{stdio:'inherit'})\"",
    "start": "electron ./main.js",
    "build": "electron-builder",
    "build-mac": "electron-builder --mac --publish=never",
    "build-mac:unsigned": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish=never -c.mac.identity=null -c.mac.notarize=false",
    "build-win": "electron-builder --win --publish=never",
    "build-linux": "electron-builder --linux --publish=never",
    "dist": "electron-builder --mac --win --linux --publish=never",
    "sync-docs": "cp vx/vx-engine.js vx/vx-keys.js docs/",
    "mix": "node bin/vexvoid-mix.js",
    "sync-catalogue": "node scripts/sync-catalogue.js",
    "relay": "node relay/server.js",
    "test:tempo": "node scripts/test-tempo.js",
    "test:timeline": "node scripts/test-timeline.js",
    "test:jobs": "node scripts/test-jobs.js",
    "test:packs": "node scripts/test-packs.mjs",
    "pack:index": "node scripts/pack-index.mjs",
    "pack:validate": "node scripts/pack-validate.mjs",
    "test:music": "node scripts/test-music.js",
    "test:webmix": "node scripts/test-webmix.js",
    "build:game": "bash scripts/build-game.sh",
    "build:writer": "/Volumes/2026/Apps/Blender.app/Contents/MacOS/Blender -b --factory-startup --python game/blender/writer.py -- vx/game/anims/ual.glb vx/game/models/writer.glb"
  },
  "keywords": [
    "animation",
    "image",
    "electron",
    "effects",
    "vj",
    "performance",
    "visual",
    "audio",
    "sequencer",
    "v3xv0id",
    "cloud"
  ],
  "author": "VexVoid",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "@supabase/supabase-js": "^2.50.0"
  },
  "build": {
    "appId": "com.b0ase.v3xv0id-av-client",
    "productName": "V3XV0ID AV Client",
    "copyright": "Copyright © 2026 VexVoid",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "api-server.js",
      "mcp/**/*",
      "relay-link.js",
      "index.html",
      "controls.html",
      "control-window.html",
      "supabase-config.js",
      "audio-manager.js",
      "performance-sequencer.js",
      "package.json",
      "vexvoid-icon.png",
      "vx/**/*"
    ],
    "icon": "vexvoid-icon.png",
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "vexvoid-icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "V3XV0ID-AV-Client-${version}-mac-universal.${ext}"
    },
    "win": {
      "icon": "vexvoid-icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "V3XV0ID-AV-Client-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "icon": "vexvoid-icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "V3XV0ID-AV-Client-${version}-linux-${arch}.${ext}",
      "category": "AudioVideo",
      "maintainer": "b0ase"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "V3XV0ID-AV-Client-${version}-win-${arch}-setup.${ext}"
    },
    "dmg": {
      "artifactName": "V3XV0ID-AV-Client-${version}-mac-universal.${ext}"
    },
    "portable": {
      "artifactName": "V3XV0ID-AV-Client-${version}-win-${arch}-portable.${ext}"
    }
  },
  "bin": {
    "vexvoid-mix": "bin/vexvoid-mix.js",
    "vexvoid-mcp": "bin/vexvoid-mcp.js"
  }
}
